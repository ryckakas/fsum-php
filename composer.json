{
    "name": "ryckakas/fsum",
    "description": "Exact, correctly rounded float summation for PHP: JavaScript Math.sumPrecise semantics, the equivalent of Python's math.fsum.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "accurate",
        "exact",
        "float",
        "floating-point",
        "fsum",
        "kahan",
        "math",
        "numerics",
        "sum",
        "sumprecise",
        "summation"
    ],
    "authors": [
        {
            "name": "Ricardas Kauneckas"
        }
    ],
    "require": {
        "php": ">=8.2",
        "php-64bit": ">=8.2"
    },
    "require-dev": {
        "ext-bcmath": "*",
        "ext-simplexml": "*",
        "bonsai-lint/bonsai-lint": "0.5.1",
        "friendsofphp/php-cs-fixer": "3.95.29",
        "infection/infection": "0.32.6",
        "phpstan/phpstan": "2.3.5",
        "phpunit/phpunit": "11.5.57"
    },
    "autoload": {
        "psr-4": {
            "Fsum\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Fsum\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "complexity": "bonsai-lint .",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover=build/coverage/clover.xml --coverage-text",
            "@php tools/check-coverage.php build/coverage/clover.xml"
        ],
        "mutation": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --show-mutations --no-interaction --threads=max"
        ],
        "soak": [
            "Composer\\Config::disableProcessTimeout",
            "@php tools/soak.php"
        ],
        "check": [
            "@cs",
            "@stan",
            "@complexity",
            "@test",
            "@php examples/example.php"
        ],
        "check:ci": [
            "@composer validate --strict",
            "@cs",
            "@stan",
            "@complexity",
            "@coverage",
            "@php examples/example.php",
            "@mutation"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite with PHPUnit.",
        "stan": "Run static analysis with PHPStan.",
        "cs": "Check code style without making changes.",
        "cs:fix": "Fix code style automatically.",
        "complexity": "Run the cognitive complexity gate (bonsai-lint).",
        "coverage": "Run tests with coverage and fail below the line-coverage floor.",
        "mutation": "Run mutation testing (Infection) and fail below the MSI floors.",
        "soak": "Run the randomized oracle comparison until a time budget runs out (seconds after --, default 60).",
        "check": "The fast local gate: code style, static analysis, complexity, tests, the README example.",
        "check:ci": "Everything the CI matrix runs, including coverage and mutation testing. Needs a coverage driver (xdebug or pcov)."
    }
}
