{
    $schema: 'vendor/infection/infection/resources/schema.json',
    source: {
        directories: [
            'src',
        ],
    },
    // The oracle tests take seconds and kill nothing the corpus misses; with them every mutant ran past the timeout.
    testFrameworkOptions: '--exclude-group=oracle',
    mutators: {
        '@default': true,
    },
    logs: {
        text: 'build/infection/infection.log',
        // Escaped mutants only, so a CI log is readable.
        summary: 'build/infection/summary.log',
        // Surviving mutants show on the PR diff, where the change was made.
        github: true,
    },
    // A point under the measured 85.2% (150 of 176). Every survivor is equivalent: a comparison on a value never zero
    // there, a swap before an addition that is exact either way, adding a zero, work after NAN or INF decided the
    // result, an initial value never read, or the overflow early exit, which the arithmetic below it reaches anyway.
    minMsi: 84,
    minCoveredMsi: 84,
    // The suite runs in about a second.
    timeout: 10,
}
