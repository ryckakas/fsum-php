{
    $schema: 'vendor/infection/infection/resources/schema.json',
    source: {
        directories: [
            'src',
        ],
    },
    // The oracle tests run bcmath on thousands of states; the v0.1 engine comparisons kill the same mutants faster.
    testFrameworkOptions: '--exclude-group=oracle',
    mutators: {
        '@default': true,
    },
    logs: {
        text: 'build/infection/infection.log',
        // Escaped mutants only, so a CI log is readable.
        summary: 'build/infection/summary.log',
        // Surviving mutants show on the PR diff, where the change was made.
        github: true,
    },
    // A point under the measured 95.4% (392 of 411). Every survivor is equivalent: it only costs speed (an earlier
    // carry pass, a skipped shortcut, a visit to an empty chunk), compares a value never zero there, returns what the
    // code below reaches anyway, uses the one add of slack in the carry budget, or moves a bit that is sticky anyway.
    minMsi: 94,
    minCoveredMsi: 94,
    // The suite without the oracle group runs in about a second.
    timeout: 10,
}
